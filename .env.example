# Server
PORT=4000
NODE_ENV=development

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/etims?retryWrites=true&w=majority

# JWT
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_EXPIRES_IN=7d

# JWT Access/Refresh tokens (Phase 1)
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Frontend URL (for CORS) - same as backend since Express serves static files
FRONTEND_ORIGIN=http://localhost:4000

# Bcrypt
BCRYPT_SALT_ROUNDS=12

# Admin bootstrap (seed script only)
ADMIN_EMAIL=admin@etims.local
ADMIN_PASSWORD=changeme123456

# AWS S3 (for Phase 2 - document uploads)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
S3_BUCKET=etims-uploads
S3_PRESIGNED_URL_EXPIRY=3600

# Redis (Upstash for prod, Docker for local)
# REDIS_URL=rediss://user:pass@host:port (Upstash TLS URL)
# Or individual:
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Upload limits
MAX_FILE_SIZE=10485760
MAX_FILES_PER_BATCH=50

# Extraction
IMAGE_MAX_DIMENSION=2000
OCR_LANGUAGE=eng
CONFIDENCE_THRESHOLD=0.85

# Worker
WORKER_CONCURRENCY=4

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100